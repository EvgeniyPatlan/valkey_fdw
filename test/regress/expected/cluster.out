-- THE KEYED LOOKUP IS REPEATED AFTER MIGRATING BACK, and that is not
-- symmetry for its own sake. Routing off the live map mid-pass duplicates a
-- row only when the NEW owner comes after the old one in the node list: the
-- key matches the stale owner, is redirected, the map refreshes, and a later
-- node then claims it again in the same pass. With the owners swapped the
-- reverse migration has the opposite ordering, so between the two of them one
-- must be the vulnerable direction whichever way the server lists its shards.
-- Asserted once only, this was green with the snapshot removed.
SELECT count(*) AS migrated_key_found_once_after_moving_back
FROM cl_t WHERE k = 'cl:{mig}k';
 migrated_key_found_once_after_moving_back 
-------------------------------------------
                                         1
(1 row)

SELECT count(*) AS rows_after_migrating_back FROM cl_t;
 rows_after_migrating_back 
---------------------------
                        61
(1 row)

-- ---------------------------------------------------------------------------
-- A REDIRECT THAT NEVER RESOLVES IS AN ERROR, NOT AN EMPTY ANSWER.
--
-- The chase is bounded, because two nodes mid-migration can point at each
-- other and an unbounded one is a hang rather than a diagnosis. What the
-- bound must not do is end the scan quietly: the keys still owed a fetch are
-- rows the query asked for, and returning without them and without a word is
-- invariant I5 run backwards - the same H2 shape as a truncating cursor,
-- reached through the slot map.
--
-- It is reachable on purpose here rather than left to a resharding window. A
-- slot left MIGRATING with the key already moved is a legitimate, stable
-- cluster state: the source owns the slot, does not hold the key, and answers
-- ASK for it forever. ASK deliberately does NOT refresh the map - one key
-- having moved says nothing about ownership - so every pass routes to the
-- same node and gets the same answer, and the budget runs out every time.
-- ---------------------------------------------------------------------------
SELECT slot AS ask_slot, host AS ask_from_h, port AS ask_from_p
FROM valkey_fdw_test_cluster_route('cl', 'cl:{ask}k') \gset
SELECT host AS ask_to_h, port AS ask_to_p
FROM valkey_fdw_test_cluster_map('cl')
WHERE (host, port) <> (:'ask_from_h', :ask_from_p)
LIMIT 1 \gset
SELECT cl_write_at_routed_node('cl:{ask}k'::bytea) AS seeded_the_asker;
 seeded_the_asker 
------------------
 accepted
(1 row)

-- Open the window and move the key, but never SETSLOT ... NODE. Ownership
-- stays where it was; only this one key is elsewhere.
SELECT cl_hold_open_ask(:ask_slot, :'ask_from_h', :ask_from_p,
                        :'ask_to_h', :ask_to_p, 'cl:{ask}k') AS window_open;
 window_open 
-------------
 open
(1 row)

SELECT count(*) FROM cl_t WHERE k = 'cl:{ask}k';
ERROR:  gave up following Valkey Cluster redirects for 1 key(s)
DETAIL:  The slot map was refreshed and the same keys were redirected again on every attempt, which is what a cluster still agreeing about a slot looks like from one client.
HINT:  Retry the statement. If it persists, the cluster is not converging: check CLUSTER INFO on every primary.
\echo unresolved redirect sqlstate: :SQLSTATE
unresolved redirect sqlstate: 40001
-- A key in another slot is still readable, so what failed was the chase for
-- this one and not the scan as a machine.
--
-- A KEYED lookup, deliberately: a full scan visits every primary and would
-- meet the unresolvable key itself, so it raises too. That is right - a scan
-- that cannot fetch a row it discovered must not report the others as if they
-- were all of them - but it makes a full scan the wrong instrument for asking
-- whether anything else still works.
SELECT count(*) AS other_key_still_readable FROM cl_t WHERE k = 'cl:{mig}k';
 other_key_still_readable 
--------------------------
                        1
(1 row)

-- Close the window so the file leaves the cluster as it found it.
SELECT cl_close_ask(:ask_slot, :'ask_from_h', :ask_from_p,
                    :'ask_to_h', :ask_to_p, 'cl:{ask}k') AS window_closed;
 window_closed 
---------------
 closed
(1 row)

-- ---------------------------------------------------------------------------
-- Slice 5: WRITES, and the guarantee that could not survive a cluster.
--
-- A transaction's writes are applied by ONE Lua program on ONE connection at
-- pre-commit, so Valkey applies all of them or none. A cluster breaks the
-- premise: a single EVAL may only touch keys in one hash slot. So a
-- cross-slot transaction cannot be one program.
--
-- THE CHOICE IS TO REFUSE rather than to split it across nodes. Splitting
-- makes partial application a normal outcome - the one thing the write path
-- works hardest to prevent - and a user who has not thought about slots
-- should not discover that in production. The refusal is actionable, which is
-- what makes it a design rather than a limitation: hash tags put related keys
-- in one slot by construction.
-- ---------------------------------------------------------------------------
-- Single-slot writes work, and go to the node that owns the slot.
BEGIN;
INSERT INTO cl_t VALUES ('cl:{w}a', 'one');
INSERT INTO cl_t VALUES ('cl:{w}b', 'two');
COMMIT;
SELECT count(*) AS single_slot_write_applied
FROM cl_t WHERE k IN ('cl:{w}a', 'cl:{w}b');
 single_slot_write_applied 
---------------------------
                         2
(1 row)

-- Those two really are one slot, so the pass above is not accidental.
SELECT count(DISTINCT slot) AS slots_written_by_that_transaction
FROM (SELECT (valkey_fdw_test_cluster_route('cl', k)).*
      FROM (VALUES ('cl:{w}a'::bytea), ('cl:{w}b')) v(k)) r;
 slots_written_by_that_transaction 
-----------------------------------
                                 1
(1 row)

-- A cross-slot transaction is refused, and the message says what to do.
BEGIN;
INSERT INTO cl_t VALUES ('cl:{p}a', 'one');
INSERT INTO cl_t VALUES ('cl:{q}b', 'two');
COMMIT;
ERROR:  a transaction writing this Valkey Cluster spans more than one hash slot
DETAIL:  Key (cl:{q}b) is in slot 11958, but this transaction already writes (cl:{p}a) in slot 16023.
HINT:  A write is applied by one script on one node, so every key it touches must share a slot. Put related keys in the same slot with a hash tag - "{tenant}:orders" and "{tenant}:items" hash only the braced part - or write them in separate transactions.
CONTEXT:  valkey_fdw pre-commit flush; no changes were applied in Valkey.
\echo crossslot sqlstate: :SQLSTATE
crossslot sqlstate: 0A000
-- REFUSED WHOLE. Not "the first key landed and the second did not" - that is
-- the partial application this refusal exists to prevent, and it is the only
-- assertion here that would catch a check placed after the first write.
SELECT count(*) AS keys_left_behind_by_the_refused_transaction
FROM cl_t WHERE k IN ('cl:{p}a', 'cl:{q}b');
 keys_left_behind_by_the_refused_transaction 
---------------------------------------------
                                           0
(1 row)

-- The two really are in different slots.
SELECT count(DISTINCT slot) AS slots_that_transaction_would_have_spanned
FROM (SELECT (valkey_fdw_test_cluster_route('cl', k)).*
      FROM (VALUES ('cl:{p}a'::bytea), ('cl:{q}b')) v(k)) r;
 slots_that_transaction_would_have_spanned 
-------------------------------------------
                                         2
(1 row)

-- The session is usable afterwards: a refusal is not a broken connection.
BEGIN;
INSERT INTO cl_t VALUES ('cl:{w}c', 'three');
COMMIT;
SELECT count(*) AS write_after_a_refusal FROM cl_t WHERE k = 'cl:{w}c';
 write_after_a_refusal 
-----------------------
                     1
(1 row)

-- A DELETE is a write too, and takes the same route.
BEGIN;
DELETE FROM cl_t WHERE k = 'cl:{w}c';
COMMIT;
SELECT count(*) AS deleted FROM cl_t WHERE k = 'cl:{w}c';
 deleted 
---------
       0
(1 row)

-- ROLLBACK still discards, on a cluster as anywhere.
BEGIN;
INSERT INTO cl_t VALUES ('cl:{w}d', 'four');
ROLLBACK;
SELECT count(*) AS rolled_back FROM cl_t WHERE k = 'cl:{w}d';
 rolled_back 
-------------
           0
(1 row)

DROP FOREIGN TABLE cl_t;
-- The per-node servers are named after addresses this suite does not choose,
-- so they are dropped by pattern rather than by name.
DO $$
DECLARE s text;
BEGIN
    FOR s IN SELECT srvname FROM pg_foreign_server WHERE srvname LIKE 'cl\_node\_%'
    LOOP
        EXECUTE format('DROP SERVER %I CASCADE', s);
    END LOOP;
END $$;
RESET client_min_messages;
DROP FUNCTION cl_write_at_routed_node(bytea);
DROP FUNCTION cl_migrate_slot(int, text, int, text, int, bytea);
DROP FUNCTION cl_hold_open_ask(int, text, int, text, int, bytea);
DROP FUNCTION cl_close_ask(int, text, int, text, int, bytea);
DROP FUNCTION cl_node_server(text, int);
DROP USER MAPPING FOR CURRENT_USER SERVER cl;
DROP SERVER cl;
