 count 
-------
     1
(1 row)

-- Sorted in SQL on the extracted key. SCAN has no defined order, so a dump
-- ordered by arrival would be recorded from luck.
SELECT convert_from(key, 'UTF8') AS keyname, keytype
  FROM valkey_fdw_test_keys('p5_srv', 0, 'p5:dump:') ORDER BY key;
   keyname    | keytype 
--------------+---------
