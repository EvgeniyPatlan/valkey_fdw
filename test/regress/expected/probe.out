-- ---------------------------------------------------------------------------
-- Cleanup. Scoped deletion, never FLUSHDB: this suite shares one Valkey with
-- nine others and a flush here would make their results a function of when
-- this file ran.
-- ---------------------------------------------------------------------------
DO $$
DECLARE
    k bytea;
BEGIN
    FOR k IN SELECT key FROM valkey_fdw_test_keys('p5_srv', 0, 'p5:') LOOP
        PERFORM valkey_fdw_test_probe('p5_srv', 0, VARIADIC ARRAY['DEL'::bytea, k]);
    END LOOP;
END $$;
SELECT count(*) AS keys_left FROM valkey_fdw_test_keys('p5_srv', 0, 'p5:');
 keys_left 
-----------
         0
(1 row)

DROP FUNCTION p5_err(text);
DROP USER MAPPING FOR CURRENT_USER SERVER p5_srv;
DROP SERVER p5_srv;
-- ---------------------------------------------------------------------------
-- The aggregate arity guard, which nothing on the wire can reach.
--
-- libvalkey's reader never hands up a short aggregate: a frame declaring more
-- elements than it carries is incomplete, so the reader waits for the rest
-- and a closing connection yields EOF rather than a truncated array. The
-- fault proxy cannot fabricate one for the same reason.
--
-- The guard is therefore defence against a libvalkey whose framing changes,
-- not against a server - which is worth keeping and worth executing. A
-- hand-built reply is the only thing that executes it.
-- ---------------------------------------------------------------------------
SELECT valkey_fdw_test_probe_child_guard();
ERROR:  a Valkey aggregate reply is missing an element it declared
