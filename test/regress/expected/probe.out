-- ---------------------------------------------------------------------------
-- 11. The key dump.
--
-- One statement that is a complete description of a scoped keyspace: which
-- keys are there and what Valkey type each one is. That is what a ROLLBACK
-- gate compares - the sorted list before against the sorted list after - and
-- why it is a set comparison and not a count. A count is accidentally
-- satisfied when one key appears and another disappears, which is exactly the
-- shape a half-applied flush has.
-- ---------------------------------------------------------------------------
SELECT count(*) FROM valkey_fdw_test_probe('p5_srv', 0, 'SET', 'p5:dump:str', 'v');
 count 
-------
     1
(1 row)

SELECT count(*) FROM valkey_fdw_test_probe('p5_srv', 0, 'HSET', 'p5:dump:hash', 'f', 'v');
 count 
-------
     1
(1 row)

