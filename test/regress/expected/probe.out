-- ---------------------------------------------------------------------------
-- 13. The logical database reaches the server.
--
-- This is the first assertion in the tree that the `database` option does
-- anything at all: no suite has ever put data on a non-zero logical database,
-- and because vfdw_conn_open starts at -1 every scan issues SELECT 0, so a
-- vfdw_conn_select_db that pinned everything to 0 would leave every suite
-- green.
--
-- The assertion has to be ASYMMETRIC, and that is the whole trick. The probe
-- calls vfdw_conn_select_db too, so writing and reading on database 3 would
-- agree with itself even if both landed on database 0. What cannot be faked is
-- reading database 0 and finding NOTHING there.
-- ---------------------------------------------------------------------------
SELECT reply_type, convert_from(val_part, 'UTF8') AS body
  FROM valkey_fdw_test_probe('p5_srv', 3, 'SET', 'p5:db:k', 'v');
 reply_type | body 
------------+------
 status     | OK
(1 row)

SELECT reply_type, convert_from(val_part, 'UTF8') AS body
  FROM valkey_fdw_test_probe('p5_srv', 3, 'GET', 'p5:db:k');
 reply_type | body 
------------+------
 string     | v
(1 row)

