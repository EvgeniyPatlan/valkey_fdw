-- ---------------------------------------------------------------------------
-- 8. Nesting stops at one level.
--
-- An element that is itself an aggregate reports its own type and element
-- count and nothing else. Documented rather than fixed: anything needing depth
-- gets a purpose-built entry point, which is what valkey_fdw_test_keys is.
-- ---------------------------------------------------------------------------
SELECT ordinal, reply_type, num, val_part
  FROM valkey_fdw_test_probe('p5_srv', 0, 'SCAN', '0', 'MATCH',
