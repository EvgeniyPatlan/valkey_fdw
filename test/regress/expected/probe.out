 p5:bin:onemb  | string
 p5:bin:utf8   | string
(3 rows)

-- The prefix is a literal, not a glob. Every metacharacter the escaper knows
-- about gets its own pair, because a vector for '*' alone leaves the rest of
-- the escape set unfalsifiable: narrowing the escaper to `if (c == '*')` and
-- running this file passed, which is how these four pairs came to exist.
--
-- Each pair is one key whose name really contains the metacharacter and one
-- decoy the metacharacter would match if it were left live. The decoy is what
-- makes the assertion bite - without it an unescaped MATCH still finds the
-- real key and the count is unchanged.
SELECT count(*) FROM valkey_fdw_test_probe('p5_srv', 0, 'SET', 'p5:g*lob:yes', '1');
 count 
