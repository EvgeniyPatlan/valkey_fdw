-- ---------------------------------------------------------------------------
-- The ledger: the buffer folded into one plan per Valkey key.
--
-- The buffer records what SQL did; the ledger records what the server has to
-- be told. Everything below reads the fold rather than the log, because the
-- fold is what S5 encodes and S6 sends, and two operations on one key must
-- collapse into one plan rather than two.
--
-- Rendered through names, never opcode numbers. A recorded file of small
-- integers survives a renumbering of the enum unchanged - every number moves
-- together - while the Lua dispatch tables that decode them would not.
-- ---------------------------------------------------------------------------
-- keyset rather than keyprefix: they are alternatives and naming both is
-- refused, so this table addresses its keys unprefixed.
CREATE FOREIGN TABLE wb_ks (k text OPTIONS (key 'true'), v text)
    SERVER wb_srv OPTIONS (tabletype 'string', keyset 'wb:index');
CREATE FOREIGN TABLE wb_zs (k text OPTIONS (key 'true'),
                           m text OPTIONS (member 'true'),
                           s text OPTIONS (score 'true'))
    SERVER wb_srv OPTIONS (tabletype 'zset', keyprefix 'wbz:');
CREATE FOREIGN TABLE wb_ls (k text OPTIONS (key 'true'), m text)
    SERVER wb_srv OPTIONS (tabletype 'list', keyprefix 'wbl:');
-- INSERT then UPDATE of one key is ONE plan, and the precondition is the one
-- the INSERT established. This is section 6.2's own example, and until S7 it
-- could not be written in SQL at all: the UPDATE matched zero rows, because a
-- statement could not see its own transaction's buffered INSERT. The overlay
-- is what makes it expressible, so the assertion and the thing it asserts
-- arrived one step apart.
BEGIN;
INSERT INTO wb_str VALUES ('wb:iu', 'first');
UPDATE wb_str SET v = 'second' WHERE k = 'wb:iu';
SELECT live_ops FROM valkey_fdw_test_wbuf_stats();
 live_ops 
----------
        2
(1 row)

SELECT plan_no, convert_from(key,'UTF8') AS key, require, state,
       kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY plan_no, kind DESC, step_no;
 plan_no |  key  |  require   |  state  |  kind  | step_no |     op     |  args  
---------+-------+------------+---------+--------+---------+------------+--------
       1 | wb:iu | KEY_ABSENT | CREATED | check  |       1 | TYPE_OK    | 
       1 | wb:iu | KEY_ABSENT | CREATED | check  |       2 | KEY_ABSENT | 
       1 | wb:iu | KEY_ABSENT | CREATED | action |       1 | SET        | first
       1 | wb:iu | KEY_ABSENT | CREATED | action |       2 | SET        | second
(4 rows)

ROLLBACK;
-- Two UPDATEs of one key are ONE plan, and the precondition is the one the
-- FIRST established. A second UPDATE that re-established it would append a
-- duplicate KEY_PRESENT; a fold that rebuilt it per operation would emit the
-- check twice and the flush would pay for it on every row of a bulk update.
BEGIN;
UPDATE wb_str SET v = 'once'  WHERE k = 'wb:f1';
UPDATE wb_str SET v = 'twice' WHERE k = 'wb:f1';
SELECT live_ops FROM valkey_fdw_test_wbuf_stats();
 live_ops 
----------
        2
(1 row)

SELECT plan_no, convert_from(key,'UTF8') AS key, require, state,
       kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY plan_no, kind DESC, step_no;
 plan_no |  key  |   require   | state |  kind  | step_no |     op      | args  
---------+-------+-------------+-------+--------+---------+-------------+-------
       1 | wb:f1 | KEY_PRESENT | LIVE  | check  |       1 | TYPE_OK     | 
       1 | wb:f1 | KEY_PRESENT | LIVE  | check  |       2 | KEY_PRESENT | 
       1 | wb:f1 | KEY_PRESENT | LIVE  | action |       1 | SET         | once
       1 | wb:f1 | KEY_PRESENT | LIVE  | action |       2 | SET         | twice
(4 rows)

ROLLBACK;
-- DELETE then INSERT is legal and keeps KEY_PRESENT from the delete. Turning
-- it into KEY_ABSENT would fail the flush for doing exactly what SQL asked -
-- the key IS present on the server, which is why the delete is there.
BEGIN;
DELETE FROM wb_str WHERE k = 'wb:g1';
INSERT INTO wb_str VALUES ('wb:g1', 'again');
SELECT plan_no, convert_from(key,'UTF8') AS key, require, state,
       kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY plan_no, kind DESC, step_no;
 plan_no |  key  |   require   | state |  kind  | step_no |     op      | args  
---------+-------+-------------+-------+--------+---------+-------------+-------
       1 | wb:g1 | KEY_PRESENT | LIVE  | check  |       1 | TYPE_OK     | 
       1 | wb:g1 | KEY_PRESENT | LIVE  | check  |       2 | KEY_PRESENT | 
       1 | wb:g1 | KEY_PRESENT | LIVE  | action |       1 | DEL         | 
       1 | wb:g1 | KEY_PRESENT | LIVE  | action |       2 | SET         | again
(4 rows)

ROLLBACK;
-- A key rename emits RENAME, not a delete and a recreate: the hash fields and
-- the TTL a delete would destroy are exactly what the user did not ask to
-- lose.
BEGIN;
UPDATE wb_str SET k = 'wb:r2' WHERE k = 'wb:r1';
SELECT plan_no, convert_from(key,'UTF8') AS key, require,
       kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY plan_no, kind DESC, step_no;
 plan_no |  key  |   require   |  kind  | step_no |     op      |  args  
---------+-------+-------------+--------+---------+-------------+--------
       1 | wb:r2 | KEY_ABSENT  | check  |       1 | TYPE_OK     | 
       1 | wb:r2 | KEY_ABSENT  | check  |       2 | KEY_ABSENT  | 
       1 | wb:r2 | KEY_ABSENT  | action |       1 | RENAME      | wb:r1
       1 | wb:r2 | KEY_ABSENT  | action |       2 | SET         | seeded
       2 | wb:r1 | KEY_PRESENT | check  |       1 | TYPE_OK     | 
       2 | wb:r1 | KEY_PRESENT | check  |       2 | KEY_PRESENT | 
(6 rows)

ROLLBACK;
-- The keyset index is maintained inside the same unit as the write, so it
-- cannot be left pointing at a key that was never created.
BEGIN;
INSERT INTO wb_ks VALUES ('wb:k1', 'v');
DELETE FROM wb_ks WHERE k = 'wb:k2';
-- require is selected here and nowhere else with an INSERT-created key: every
-- other block above establishes its precondition from an UPDATE or a DELETE,
-- so KEY_ABSENT could be replaced by KEY_PRESENT throughout and only the check
-- opcode would move. Measured, not assumed.
SELECT plan_no, convert_from(key,'UTF8') AS key, require, kind, step_no, op,
       convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY plan_no, kind DESC, step_no;
 plan_no |  key  |   require   |  kind  | step_no |     op      |      args      
---------+-------+-------------+--------+---------+-------------+----------------
       1 | wb:k1 | KEY_ABSENT  | check  |       1 | TYPE_OK     | 
       1 | wb:k1 | KEY_ABSENT  | check  |       2 | KEY_ABSENT  | 
       1 | wb:k1 | KEY_ABSENT  | action |       1 | SET         | v
       1 | wb:k1 | KEY_ABSENT  | action |       2 | KSET_ADD    | wb:index|wb:k1
       2 | wb:k2 | KEY_PRESENT | check  |       1 | TYPE_OK     | 
       2 | wb:k2 | KEY_PRESENT | check  |       2 | KEY_PRESENT | 
       2 | wb:k2 | KEY_PRESENT | action |       1 | DEL         | 
       2 | wb:k2 | KEY_PRESENT | action |       2 | KSET_REM    | wb:index|wb:k2
(8 rows)

ROLLBACK;
-- A member rename is ZREM then ZADD, in that order. The reverse ordering is
-- correct only because the two names differ, and silently deletes the row on
-- the day they do not.
BEGIN;
UPDATE wb_zs SET m = 'new' WHERE k = 'wbz:k' AND m = 'old';
SELECT kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY kind DESC, step_no;
  kind  | step_no |       op        | args  
--------+---------+-----------------+-------
 check  |       1 | TYPE_OK         | 
 check  |       2 | KEY_PRESENT     | 
 check  |       3 | ZMEMBER_PRESENT | old
 action |       1 | ZREM            | old
 action |       2 | ZADD            | 1|new
(5 rows)

ROLLBACK;
-- A list may hold one value many times, so presence is a count rather than a
-- yes or no. Two pushes of one value emit two RPUSHes and ask the server for
-- nothing; a delete of a value this transaction did NOT push asks for one.
BEGIN;
INSERT INTO wb_ls VALUES ('wbl:k', 'dup');
INSERT INTO wb_ls VALUES ('wbl:k', 'dup');
SELECT kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY kind DESC, step_no;
  kind  | step_no |     op     | args 
--------+---------+------------+------
 check  |       1 | TYPE_OK    | 
 check  |       2 | KEY_ABSENT | 
 action |       1 | RPUSH      | dup
 action |       2 | RPUSH      | dup
(4 rows)

ROLLBACK;
BEGIN;
DELETE FROM wb_ls WHERE k = 'wbl:d' AND m = 'gone';
SELECT live_ops FROM valkey_fdw_test_wbuf_stats();
 live_ops 
----------
        1
(1 row)

SELECT kind, step_no, op, convert_from(args,'UTF8') AS args
FROM valkey_fdw_test_ledger() ORDER BY kind DESC, step_no;
  kind  | step_no |       op        |  args  
--------+---------+-----------------+--------
 check  |       1 | TYPE_OK         | 
 check  |       2 | KEY_PRESENT     | 
 check  |       3 | LVALUE_COUNT_GE | gone|1
 action |       1 | LREM1           | gone
(4 rows)

ROLLBACK;
-- ---------------------------------------------------------------------------
-- Inserting a key this transaction already created raises 23505 AT THE
-- STATEMENT.
--
-- The alternative every plain per-key fold produces is a last-writer-wins
-- overwrite that reports two rows inserted and leaves one - a lost row with
-- no error anywhere. The row count matters as much as the SQLSTATE, so both
-- are asserted.
-- ---------------------------------------------------------------------------
BEGIN;
INSERT INTO wb_str VALUES ('wb:dup', 'one');
SELECT wb_err($$INSERT INTO wb_str VALUES ('wb:dup', 'two')$$) AS second_insert;
                      second_insert                      
---------------------------------------------------------
 23505: duplicate key value violates the Valkey keyspace
(1 row)

SELECT live_ops FROM valkey_fdw_test_wbuf_stats();
 live_ops 
----------
        1
(1 row)

SELECT count(*) AS plans FROM (SELECT DISTINCT plan_no
                               FROM valkey_fdw_test_ledger()) d;
 plans 
-------
     1
(1 row)

ROLLBACK;
-- An UPDATE first, then an INSERT of the same key: the key exists remotely,
-- so this is the same duplicate and must be refused for the same reason.
BEGIN;
UPDATE wb_str SET v = 'x' WHERE k = 'wb:dup2';
SELECT wb_err($$INSERT INTO wb_str VALUES ('wb:dup2', 'y')$$) AS insert_after_update;
                   insert_after_update                   
---------------------------------------------------------
 23505: duplicate key value violates the Valkey keyspace
(1 row)

ROLLBACK;
-- A second INSERT of the same zset MEMBER is refused one level down, while a
-- second row on the same KEY is not: a zset key holds many rows by design.
BEGIN;
INSERT INTO wb_zs VALUES ('wbz:m', 'a', '1');
INSERT INTO wb_zs VALUES ('wbz:m', 'b', '2');
SELECT live_ops FROM valkey_fdw_test_wbuf_stats();
 live_ops 
----------
        2
(1 row)

SELECT wb_err($$INSERT INTO wb_zs VALUES ('wbz:m', 'a', '3')$$) AS duplicate_member;
                   duplicate_member                   
------------------------------------------------------
 23505: duplicate member violates the Valkey keyspace
(1 row)

ROLLBACK;
-- ---------------------------------------------------------------------------
-- The incremental fold and the rebuild agree.
--
-- vfdw_ledger_note runs per row; vfdw_ledger_rebuild_from_buffer re-folds the
-- whole surviving log after a truncation. If they could disagree, a savepoint
-- would silently change what COMMIT applies. ROLLBACK TO SAVEPOINT forces the
-- rebuild; the surviving prefix must fold to exactly what it folded to on the
-- way in.
-- ---------------------------------------------------------------------------
BEGIN;
INSERT INTO wb_str VALUES ('wb:eq1', 'a');
INSERT INTO wb_ks VALUES ('wb:eq2', 'b');
UPDATE wb_str SET v = 'c' WHERE k = 'wb:eq1';
CREATE TEMP TABLE wb_fold_before AS
    SELECT plan_no, key, require, state, kind, step_no, op, args
    FROM valkey_fdw_test_ledger();
SAVEPOINT eq;
INSERT INTO wb_str VALUES ('wb:eq3', 'd');
UPDATE wb_ks SET v = 'e' WHERE k = 'wb:eq2';
ROLLBACK TO SAVEPOINT eq;
SELECT count(*) = 0 AS fold_identical_after_rebuild
FROM ((SELECT * FROM wb_fold_before
       EXCEPT ALL
       SELECT plan_no, key, require, state, kind, step_no, op, args
       FROM valkey_fdw_test_ledger())
      UNION ALL
      (SELECT plan_no, key, require, state, kind, step_no, op, args
       FROM valkey_fdw_test_ledger()
       EXCEPT ALL
       SELECT * FROM wb_fold_before)) d;
 fold_identical_after_rebuild 
------------------------------
 t
(1 row)

-- And the rebuild really did discard the rolled-back work: the key the
-- savepoint created is gone from the fold entirely.
SELECT count(*) AS eq3_plans FROM valkey_fdw_test_ledger()
WHERE key = 'wb:eq3'::bytea;
 eq3_plans 
-----------
         0
(1 row)

ROLLBACK;
-- The ledger is dropped with the buffer. It points into the buffer's memory,
-- so surviving a reset would mean reading the next transaction's bytes.
SELECT count(*) AS ledger_empty_between_transactions
FROM valkey_fdw_test_ledger();
 ledger_empty_between_transactions 
-----------------------------------
                                 0
(1 row)

-- ---------------------------------------------------------------------------
-- Which columns each operation was planned against.
--
-- vfdw_modify_target_attrs had no observable anywhere: not in the buffer
-- dump, not in EXPLAIN, not in fdw_private printing. Making it return NIL was
-- run and left every suite green - thirty-five lines of plan-time logic whose
-- removal nothing noticed.
--
-- The distinction worth asserting is INSERT against UPDATE. An INSERT writes
-- every non-dropped column and targets all of them. An UPDATE targets only
-- the columns the statement assigned, so updating one column of a three-
-- column table must show ONE attnum here. Collapsing the two would make an
-- UPDATE rewrite fields it was never asked to touch.
-- ---------------------------------------------------------------------------
CREATE FOREIGN TABLE wt (k text OPTIONS (key 'true'),
                         a text OPTIONS (field 'a'),
                         b text OPTIONS (field 'b'))
    SERVER wb_srv OPTIONS (tabletype 'hash', keyprefix 'wt:');
BEGIN;
INSERT INTO wt VALUES ('wt:1', 'x', 'y');
-- All three columns: k, a, b.
SELECT ordinal, kind, attnum FROM valkey_fdw_test_wbuf_targets()
ORDER BY ordinal, attnum;
 ordinal |  kind  | attnum 
---------+--------+--------
       1 | insert |      1
       1 | insert |      2
       1 | insert |      3
(3 rows)

ROLLBACK;
BEGIN;
INSERT INTO wt VALUES ('wt:2', 'x', 'y');
UPDATE wt SET b = 'z' WHERE k = 'wt:2';
-- The INSERT still targets all three; the UPDATE targets only b (attnum 3).
-- If the UPDATE branch were dropped it would show all three here too.
SELECT ordinal, kind, attnum FROM valkey_fdw_test_wbuf_targets()
ORDER BY ordinal, attnum;
 ordinal |  kind  | attnum 
---------+--------+--------
       1 | insert |      1
       1 | insert |      2
       1 | insert |      3
       2 | update |      3
(4 rows)

ROLLBACK;
DROP FOREIGN TABLE wt;
-- ---------------------------------------------------------------------------
-- A statement that buffers nothing costs nothing.
--
-- target_attrs has to live in the write-buffer context, because the fold
-- reads it at pre-commit long after the statement that planned it is gone.
-- Building it at BeginForeignModify charged every DML statement against
-- write_max_bytes whether or not it buffered a row: an UPDATE matching
-- nothing, or a statement refused before its first row, left a bitmap behind
-- for the rest of the transaction. Building it on first use instead is
-- buffered no rows at all.
-- ---------------------------------------------------------------------------
CREATE FOREIGN TABLE wg (k text OPTIONS (key 'true'),
                         a text OPTIONS (field 'a'),
                         b text OPTIONS (field 'b'))
    SERVER wb_srv OPTIONS (tabletype 'hash', keyprefix 'wg:');
BEGIN;
INSERT INTO wg VALUES ('wg:1', 'x', 'y');
SELECT alloc_bytes AS wg_before FROM valkey_fdw_test_wbuf_stats() \gset
-- MANY statements, not one. alloc_bytes reports the context's allocated
-- BLOCKS, so a single bitmap fits inside a block already held and the delta
-- is zero whether it was built eagerly or not - the first version of this
-- assertion said 0 with the eager build restored, and asserted nothing.
-- Five hundred crosses a block boundary and makes the difference visible.
DO $wg$
BEGIN
    FOR i IN 1..500 LOOP
        UPDATE wg SET a = 'q' WHERE k = 'wg:nosuchkey';
    END LOOP;
END $wg$;
SELECT alloc_bytes - :wg_before AS bytes_for_500_statements_that_buffered_nothing
FROM valkey_fdw_test_wbuf_stats();
 bytes_for_500_statements_that_buffered_nothing 
------------------------------------------------
                                              0
(1 row)

ROLLBACK;
DROP FOREIGN TABLE wg;
