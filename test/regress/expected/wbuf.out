COMMIT PREPARED 'wb_prep_empty';
-- ---------------------------------------------------------------------------
-- The connection is acquired at the DML statement, and the lease is returned.
-- ---------------------------------------------------------------------------
-- A server pointed at a port nothing listens on: the failure must be reported
-- at the INSERT, not at COMMIT.
CREATE SERVER wb_dead FOREIGN DATA WRAPPER valkey_fdw
    OPTIONS (host 'valkey', port '1');
CREATE USER MAPPING FOR CURRENT_USER SERVER wb_dead;
CREATE FOREIGN TABLE wb_dead_t (k text OPTIONS (key 'true'), v text)
    SERVER wb_dead OPTIONS (tabletype 'string', keyprefix 'wb:');
BEGIN;
SELECT wb_state($$INSERT INTO wb_dead_t VALUES ('wb:d','v')$$) AS unreachable_at_dml;
 unreachable_at_dml 
--------------------
 08006
(1 row)

SELECT live_ops, bound FROM valkey_fdw_test_wbuf_stats();
 live_ops | bound 
----------+-------
        0 | f
(1 row)

ROLLBACK;
-- The lease is returned, so a transaction may run more DML statements than
-- there are connection slots. Holding one per statement would fail the 33rd
-- with "too many concurrent Valkey scans on one server" - a message wrong in
-- both of its nouns.
SELECT open FROM valkey_fdw_test_pool_stats() \gset lease_before_
BEGIN;
DO $$
BEGIN
    FOR i IN 1..40 LOOP
        EXECUTE format('INSERT INTO wb_str VALUES (%L, %L)', 'wb:lease'||i, 'v');
    END LOOP;
END $$;
SELECT live_ops FROM valkey_fdw_test_wbuf_stats();
 live_ops 
----------
       40
(1 row)

SELECT open = :lease_before_open AS no_extra_connections
FROM valkey_fdw_test_pool_stats();
 no_extra_connections 
----------------------
 t
(1 row)

ROLLBACK;
-- Nothing above reached Valkey, so the keyspace is still where it started.
SELECT count(*) = 0 AS keyspace_still_identical
FROM ((SELECT key, keytype FROM valkey_fdw_test_keys('wb_srv', 0, 'wb:')
       EXCEPT ALL
       SELECT key, keytype FROM wb_before)
      UNION ALL
      (SELECT key, keytype FROM wb_before
       EXCEPT ALL
       SELECT key, keytype FROM valkey_fdw_test_keys('wb_srv', 0, 'wb:'))) d;
