# RPM build image. BASE selects the target; PG_MAJOR selects the PGDG repo.
#
#   oraclelinux:8 / :9 / :10        -> Oracle Linux
#   amazonlinux:2023                -> Amazon Linux 2023
#
# Amazon Linux 2023 has no PGDG repository, so PostgreSQL comes from its own
# repos. It packages PostgreSQL itself and names things its own way: the
# development package is postgresql<n>-server-devel, and the tree lives at
# /usr/lib64/pgsql rather than /usr/pgsql-<n>. The spec learns the second from
# pg_config; the first is a package name, which only this file can know.
ARG BASE=oraclelinux:9
FROM ${BASE}

ARG PG_MAJOR=17
ARG EL=9

RUN set -eux; \
    # NOT in parentheses. A subshell would set PKG inside it and leave it
    # unset out here, and `set -u` then aborts on the very next line with
    # "PKG: unbound variable" - which is what actually failed here twice
    # while two rounds of repository guessing went looking for a dnf problem.
    if command -v dnf >/dev/null; then PKG=dnf; else PKG=yum; fi; \
    # clang is named rather than inherited. PGXS emits LLVM bitcode beside
    # every object whenever the server was built --with-llvm, which every
    # PGDG build is, and it invokes /usr/bin/clang to do it - so a toolchain
    # without clang fails at the first .bc with "No such file or directory"
    # and an exit status of 127, a hundred lines after the last thing that
    # looked like a compiler problem. It used to arrive as a dependency of
    # the PostgreSQL development package and stopped, which turned a green
    # matrix red with nothing in this repository having changed. A build
    # input this repository depends on is named here or it is not depended
    # on at all.
    $PKG install -y --allowerasing \
        gcc gcc-c++ clang make cmake git tar rpm-build openssl-devel \
        redhat-rpm-config findutils which dnf-plugins-core || true; \
    if command -v amazon-linux-extras >/dev/null 2>&1 || grep -qi amazon /etc/os-release; then \
        # postgresql<n>-SERVER-devel, which is what Amazon Linux calls it.
        # Every other target in this file says postgresql<n>-devel, and
        # installing that name here succeeds at nothing: dnf reports no match,
        # `|| true` above swallows it, and the failure finally arrives as a
        # missing pgxs.mk hundreds of lines later. AL2023 carries 15 through
        # 18, so 14 - which this tree does support - cannot be built here.
        # scripts/package.sh refuses that pair before reaching this image and
        # the workflow excludes it from the matrix; nothing below would say
        # anything useful about it.
        $PKG install -y "postgresql${PG_MAJOR}-server-devel" "postgresql${PG_MAJOR}-server"; \
    else \
        $PKG install -y \
          "https://download.postgresql.org/pub/repos/yum/reporpms/EL-${EL}-x86_64/pgdg-redhat-repo-latest.noarch.rpm" \
          || $PKG install -y \
          "https://download.postgresql.org/pub/repos/yum/reporpms/EL-${EL}-aarch64/pgdg-redhat-repo-latest.noarch.rpm"; \
        $PKG -qy module disable postgresql || true; \
        # postgresql-devel needs perl(IPC::Run), which on Oracle Linux lives
        # in CodeReady Builder - NOT in EPEL, which is what two rounds of
        # guessing assumed before asking `dnf provides` and being told
        # plainly. dnf-plugins-core is installed above because config-manager
        # comes from it: without it this line fails, `|| true` swallows the
        # failure, the repo is never enabled, and the error you finally see
        # names only the Perl module - which sends you looking for a Perl
        # problem rather than a repository one.
        $PKG config-manager --set-enabled "ol${EL}_codeready_builder" \
            || $PKG config-manager --set-enabled crb; \
        $PKG install -y "postgresql${PG_MAJOR}-devel" "postgresql${PG_MAJOR}-server"; \
    fi; \
    $PKG clean all

WORKDIR /work
